@using StudyHub.Logic.Domain.Courses

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">@(EditingCourse is null ? "New Course" : "Edit Course")</div>
                <button class="icon-btn" type="button" aria-label="Close" @onclick="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <EditForm Model="this" OnValidSubmit="SubmitAsync">
                <div class="modal-body">
                    @if (ErrorMessage is not null)
                    {
                        <div class="form-error">@ErrorMessage</div>
                    }

                    <div class="form-group">
                        <label for="course-name">Name</label>
                        <input id="course-name" class="form-control" maxlength="@Course.NameMaxLength" @bind="Name" />
                    </div>

                    <div class="form-group">
                        <label for="course-description">Description</label>
                        <textarea id="course-description" class="form-control" rows="3" maxlength="@Course.DescriptionMaxLength" @bind="Description"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="course-color">Color</label>
                        <div class="color-field">
                            <input id="course-color" type="color" @bind="Color" />
                            <span class="mono">@Color</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="course-semester">Semester</label>
                        <select id="course-semester" class="form-control" @bind="SemesterId">
                            <option value="@Guid.Empty">Select a semester…</option>
                            @foreach (var semester in SelectableSemesters)
                            {
                                <option value="@semester.Id">@semester.Name@(semester.IsArchived ? " (Archived)" : "")</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" @onclick="Close" disabled="@IsSaving">Cancel</button>
                    <button class="btn btn-primary" type="submit" disabled="@IsSaving">@(EditingCourse is null ? "Create Course" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}
