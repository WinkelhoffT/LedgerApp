@using StudyHub.Shared.StudySessions

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">@(EditingSession is null ? "New Session" : "Edit Session")</div>
                <button class="icon-btn" type="button" aria-label="Close" @onclick="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <EditForm Model="this" OnValidSubmit="SubmitAsync">
                <div class="modal-body">
                    @if (ErrorMessage is not null)
                    {
                        <div class="form-error">@ErrorMessage</div>
                    }

                    <div class="form-group">
                        <label for="session-title">Title</label>
                        <input id="session-title" class="form-control" maxlength="@StudySession.TitleMaxLength" @bind="Title" />
                    </div>

                    <div class="form-group">
                        <label for="session-owner">Belongs to (optional)</label>
                        <select id="session-owner" class="form-control" @bind="OwnerKey">
                            <option value="">No course or semester</option>
                            @if (SelectableCourses.Any())
                            {
                                <optgroup label="Courses">
                                    @foreach (var course in SelectableCourses)
                                    {
                                        <option value="@(CoursePrefix + course.Id)">@course.Name@(course.IsArchived ? " (Archived)" : "")</option>
                                    }
                                </optgroup>
                            }
                            @if (SelectableSemesters.Any())
                            {
                                <optgroup label="Semesters">
                                    @foreach (var semester in SelectableSemesters)
                                    {
                                        <option value="@(SemesterPrefix + semester.Id)">@semester.Name@(semester.IsArchived ? " (Archived)" : "")</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="session-date">Date</label>
                            <input id="session-date" class="form-control" type="date" @bind="Date" />
                        </div>
                        <div class="form-group">
                            <label for="session-start">Start</label>
                            <input id="session-start" class="form-control" type="time" step="300" @bind="StartTime" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="session-duration">Duration (minutes)</label>
                            <input id="session-duration" class="form-control" type="number" step="5"
                                   min="@StudySession.MinDurationMinutes" max="@StudySession.MaxDurationMinutes" @bind="DurationMinutes" />
                        </div>
                        <div class="form-group">
                            <label for="session-location">Location (optional)</label>
                            <input id="session-location" class="form-control" maxlength="@StudySession.LocationMaxLength" @bind="Location" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    @if (EditingSession is not null)
                    {
                        <div class="modal-footer-start">
                            @if (IsConfirmingDelete)
                            {
                                <button class="btn btn-danger-outline" type="button" disabled="@IsSaving" @onclick="DeleteAsync">Delete?</button>
                                <button class="btn btn-secondary" type="button" disabled="@IsSaving" @onclick="() => IsConfirmingDelete = false">Keep</button>
                            }
                            else
                            {
                                <button class="btn btn-danger-outline" type="button" disabled="@IsSaving" @onclick="() => IsConfirmingDelete = true">Delete</button>
                            }
                        </div>
                    }
                    <button class="btn btn-secondary" type="button" @onclick="Close" disabled="@IsSaving">Cancel</button>
                    <button class="btn btn-primary" type="submit" disabled="@IsSaving">@(EditingSession is null ? "Add Session" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}
