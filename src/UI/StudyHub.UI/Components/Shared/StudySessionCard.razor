@using StudyHub.UI.Calendar

@{
    RenderFragment content =
        @<text>
            <span class="sc-time">@CalendarFormatter.FormatTimeRange(Session) · @CalendarFormatter.FormatDuration(Session.DurationMinutes)</span>
            <span class="sc-title">@Session.Title</span>
            @if (Session.OwnerName is not null)
            {
                <span class="sc-sub">@Session.OwnerName</span>
            }
            @if (Session.Location is not null)
            {
                <span class="sc-sub sc-location">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
                    @Session.Location
                </span>
            }
        </text>;
}

<div class="session-card @PastClass @(Session.IsCompleted ? "is-done" : null)" style="--session-color:@CalendarFormatter.GetColor(Session)">
    @if (OnSelected.HasDelegate)
    {
        <button class="session-card-main session-card-button" type="button"
                aria-label="@($"Edit {CalendarFormatter.FormatSessionLabel(Session)}")" @onclick="() => OnSelected.InvokeAsync(Session)">
            @content
        </button>
    }
    else
    {
        <div class="session-card-main">
            @content
        </div>
    }

    @if (Session.IsCompleted)
    {
        <span class="sc-done"><DoneIcon Size="13" /> @CalendarFormatter.FormatDone(Session)</span>
    }
    else if (CanComplete)
    {
        <button class="btn btn-outline btn-sm sc-complete" type="button" disabled="@IsCompleting"
                aria-label="@($"Mark {Session.Title} as done")" @onclick="CompleteAsync">
            <DoneIcon Size="13" />
            Mark as done
        </button>
    }

    @if (ErrorMessage is not null)
    {
        <span class="sc-error" role="alert">@ErrorMessage</span>
    }
</div>
