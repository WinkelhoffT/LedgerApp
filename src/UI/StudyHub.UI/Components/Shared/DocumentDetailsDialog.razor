@using StudyHub.UI.Documents

@if (IsOpen && Document is not null)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">@Document.FileName</div>
                <button class="icon-btn" type="button" aria-label="Close" @onclick="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="modal-body">
                @if (Document.IsArchived)
                {
                    <span class="badge-archived">Archived</span>
                }

                <div class="detail-row"><span>Type</span><span>@Document.ContentType</span></div>
                <div class="detail-row"><span>Size</span><span>@FileSizeFormatter.Format(Document.SizeBytes)</span></div>
                <div class="detail-row"><span>Belongs to</span><span>@ParentName</span></div>
                <div class="detail-row"><span>Uploaded</span><span>@Document.CreatedAt.ToLocalTime().ToString("g")</span></div>
                <div class="detail-row"><span>Last updated</span><span>@Document.UpdatedAt.ToLocalTime().ToString("g")</span></div>
            </div>

            <div class="modal-footer">
                @if (Document.IsArchived)
                {
                    <button class="btn btn-secondary" type="button" @onclick="RestoreAsync" disabled="@IsProcessing">Restore</button>
                }
                else
                {
                    <button class="btn btn-danger-outline" type="button" @onclick="ArchiveAsync" disabled="@IsProcessing">Archive</button>
                }
                <a class="btn btn-primary" href="documents/@Document.Id/download">Download</a>
            </div>
        </div>
    </div>
}
