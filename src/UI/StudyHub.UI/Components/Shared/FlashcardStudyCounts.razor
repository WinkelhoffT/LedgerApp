<span class="study-counts" aria-label="@($"{Counts.New} new, {Counts.Learning} learning, {Counts.Review} to review")">
    <span class="study-count count-new" title="New">@Counts.New</span>
    <span class="study-count count-learning" title="Learning">@Counts.Learning</span>
    <span class="study-count count-review" title="To review">@Counts.Review</span>
</span>
