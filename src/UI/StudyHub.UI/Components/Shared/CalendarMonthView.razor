@using StudyHub.UI.Calendar

<div class="cal-grid">
    @foreach (var weekday in Month.Days.Take(7))
    {
        <div class="cal-dow">@CalendarFormatter.FormatShortWeekday(weekday.Date)</div>
    }

    @foreach (var day in Month.Days)
    {
        <div class="cal-cell @GetCellClass(day)" @onclick="() => OnDaySelected.InvokeAsync(day.Date)">
            <button class="cal-num" type="button" aria-label="@CalendarFormatter.FormatDate(day.Date)"
                    aria-pressed="@(day.Date == SelectedDate ? "true" : "false")" aria-current="@(day.Date == Month.Today ? "date" : null)">
                @day.Date.Day
            </button>
            @foreach (var item in day.Sessions.Take(MaxChips))
            {
                <button class="cal-ev @(day.Date < Month.Today ? "is-past" : null)" type="button"
                        style="--session-color:@CalendarFormatter.GetColor(item.Session)" aria-label="@CalendarFormatter.FormatSessionLabel(item.Session)">
                    @CalendarFormatter.FormatTime(item.Session.StartTime) @item.Session.Title
                </button>
            }
            @if (day.Sessions.Count > MaxChips)
            {
                <span class="cal-more">+@(day.Sessions.Count - MaxChips) more</span>
            }
        </div>
    }
</div>
