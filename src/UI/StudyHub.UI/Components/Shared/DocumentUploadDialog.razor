@using Microsoft.AspNetCore.Components.Forms
@using StudyHub.UI.Documents

@if (IsOpen)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-title">Upload Document</div>
                <button class="icon-btn" type="button" aria-label="Close" @onclick="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <EditForm Model="this" OnValidSubmit="SubmitAsync">
                <div class="modal-body">
                    @if (ErrorMessage is not null)
                    {
                        <div class="form-error">@ErrorMessage</div>
                    }

                    <div class="form-group">
                        <label for="document-file">File (PDF or DOCX, max @FileSizeFormatter.Format(MaxFileSizeBytes))</label>
                        <InputFile id="document-file" class="form-control" accept=".pdf,.docx" OnChange="HandleFileSelected" />
                        @if (SelectedFile is not null)
                        {
                            <span class="mono">@SelectedFile.Name (@FileSizeFormatter.Format(SelectedFile.Size))</span>
                        }
                    </div>

                    <div class="form-group">
                        <label for="document-assignment">Belongs to</label>
                        <select id="document-assignment" class="form-control" @bind="AssignmentKind">
                            <option value="@AssignmentTarget.Course">Course</option>
                            <option value="@AssignmentTarget.Semester">Semester</option>
                        </select>
                    </div>

                    @if (AssignmentKind == AssignmentTarget.Course)
                    {
                        <div class="form-group">
                            <label for="document-course">Course</label>
                            <select id="document-course" class="form-control" @bind="CourseId">
                                <option value="@Guid.Empty">Select a course…</option>
                                @foreach (var course in SelectableCourses)
                                {
                                    <option value="@course.Id">@course.Name@(course.IsArchived ? " (Archived)" : "")</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label for="document-semester">Semester</label>
                            <select id="document-semester" class="form-control" @bind="SemesterId">
                                <option value="@Guid.Empty">Select a semester…</option>
                                @foreach (var semester in SelectableSemesters)
                                {
                                    <option value="@semester.Id">@semester.Name@(semester.IsArchived ? " (Archived)" : "")</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" @onclick="Close" disabled="@IsSaving">Cancel</button>
                    <button class="btn btn-primary" type="submit" disabled="@(IsSaving || SelectedFile is null)">Upload</button>
                </div>
            </EditForm>
        </div>
    </div>
}
