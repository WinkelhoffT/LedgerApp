@page "/flashcards"

<PageTitle>Flashcards</PageTitle>

<div class="page-toolbar">
    <label class="toggle-check">
        <input type="checkbox" @bind="ShowArchived" @bind:after="LoadDecksAsync" />
        Show archived
    </label>
    <div class="toolbar-actions">
        <a class="btn btn-outline" href="flashcards/generate">Generate with AI</a>
        <button class="btn btn-secondary" type="button" @onclick="() => IsImportOpen = true">Import</button>
        <button class="btn btn-primary" type="button" @onclick="() => IsDeckDialogOpen = true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            New deck
        </button>
    </div>
</div>

@if (ErrorMessage is not null)
{
    <div class="form-error page-error">@ErrorMessage</div>
}

@if (Decks is null)
{
    <p class="placeholder-hint">Loading decks…</p>
}
else if (Decks.Count == 0)
{
    <div class="card empty-state">
        <div class="empty-state-title">@(ShowArchived ? "No decks yet" : "No flashcard decks yet")</div>
        <div class="empty-state-text">
            Build a deck from your notes, import one from Anki, or let the AI generate one. Review with spaced repetition to remember more.
        </div>
        <div class="empty-state-actions">
            <button class="btn btn-primary" type="button" @onclick="() => IsDeckDialogOpen = true">Create Deck</button>
            <button class="btn btn-secondary" type="button" @onclick="() => IsImportOpen = true">Import from Anki</button>
        </div>
    </div>
}
else
{
    <div class="card flashcard-table-card">
        <table class="table flashcard-table deck-table">
            <thead>
                <tr>
                    <th>Deck</th>
                    <th class="deck-course-col">Course</th>
                    <th class="deck-number-col">Cards</th>
                    <th class="deck-due-col">Due today</th>
                    <th class="deck-actions-col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var deck in Decks)
                {
                    <tr class="@(deck.IsArchived ? "is-archived" : "")">
                        <td>
                            <a class="deck-name" href="@($"flashcards/decks/{deck.Id}")">@deck.Name</a>
                            @if (deck.IsArchived)
                            {
                                <span class="badge-archived">Archived</span>
                            }
                        </td>
                        <td class="deck-course-col">@GetCourseName(deck.CourseId)</td>
                        <td class="deck-number-col">@deck.CardCount</td>
                        <td class="deck-due-col"><FlashcardStudyCounts Counts="deck.DueCounts" /></td>
                        <td class="deck-actions-col">
                            @if (!deck.IsArchived && deck.DueCounts.Total > 0)
                            {
                                <a class="btn btn-primary btn-sm" href="@($"flashcards/study/{deck.Id}")">Study</a>
                            }
                            <a class="btn btn-outline btn-sm" href="@($"flashcards/decks/{deck.Id}")">Open</a>
                            <button class="btn btn-outline btn-sm" type="button" disabled="@(ExportingDeckId == deck.Id)" @onclick="() => ExportAsync(deck)">Export</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<FlashcardDeckFormDialog IsOpen="IsDeckDialogOpen" OnClose="() => IsDeckDialogOpen = false" OnSaved="HandleDeckCreated" />

<FlashcardImportDialog IsOpen="IsImportOpen" Decks="ActiveDecks" OnClose="() => IsImportOpen = false" OnImported="LoadDecksAsync" />
