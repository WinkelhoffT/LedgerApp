@page "/notes/new"
@page "/notes/{Id:guid}"
@rendermode InteractiveServer
@implements IDisposable
@using StudyHub.Logic.Business.Courses
@using StudyHub.Logic.Business.Notes
@using StudyHub.Logic.Business.Notes.Commands
@using StudyHub.Logic.Domain.Notes
@inject INoteManagement NoteManagement
@inject ICourseManagement CourseManagement
@inject NavigationManager NavigationManager
@inject IPageHeaderService PageHeader
@inject IMarkdownBlockParser BlockParser
@inject ISlashTriggerDetector TriggerDetector
@inject ISlashCommandRegistry CommandRegistry
@inject IJSRuntime JS

<PageTitle>@(Id is null ? "New Note" : Title)</PageTitle>

@if (!IsLoaded)
{
    <p class="placeholder-hint">Loading…</p>
}
else if (CourseList!.Count == 0)
{
    <div class="card empty-state">
        <div class="empty-state-title">No courses yet</div>
        <div class="empty-state-text">Notes belong to a course. Create your first course before adding notes.</div>
        <a class="btn btn-primary" href="/courses">Go to Courses</a>
    </div>
}
else
{
    <div class="note-editor-page">
        <div class="note-editor-topline">
            <a class="btn btn-outline btn-sm" href="/notes">&larr; Back to Notes</a>
            <div class="note-editor-topline-actions">
                <select class="form-control note-course-select" @bind="CourseId" disabled="@IsArchived">
                    <option value="@Guid.Empty">Select a course…</option>
                    @foreach (var course in CourseList)
                    {
                        <option value="@course.Id">@course.Name@(course.IsArchived ? " (Archived)" : "")</option>
                    }
                </select>
                @if (!IsArchived)
                {
                    <button class="btn btn-primary btn-sm" type="button" @onclick="SaveAsync" disabled="@IsSaving">
                        @(IsSaving ? "Saving…" : "Save")
                    </button>
                }
            </div>
        </div>

        @if (ErrorMessage is not null)
        {
            <div class="form-error">@ErrorMessage</div>
        }
        @if (IsArchived)
        {
            <div class="note-readonly-banner">This note is archived and read-only.</div>
        }

        <input class="note-title-input" placeholder="Untitled" maxlength="@Note.TitleMaxLength" @bind="Title" disabled="@IsArchived" />

        <div class="note-editor-blocks">
            @foreach (var block in Blocks)
            {
                @if (block.IsCode)
                {
                    <div class="note-code-block" @key="block.Id">
                        <input class="note-code-lang" placeholder="language" @bind="block.Language" disabled="@IsArchived" />
                        <div class="note-code-editor">
                            <pre class="note-code-highlight" aria-hidden="true"><code class="language-@NormalizeLanguage(block.Language)">@(block.Text)
</code></pre>
                            <textarea
                                @ref="block.TextAreaElement"
                                class="note-code-textarea"
                                spellcheck="false"
                                @bind="block.Text"
                                @bind:event="oninput"
                                disabled="@IsArchived"></textarea>
                        </div>
                    </div>
                }
                else
                {
                    <div class="note-block-wrap" @key="block.Id">
                        <textarea
                            @ref="block.TextAreaElement"
                            class="note-text-block"
                            rows="@GetRows(block.Text)"
                            @bind="block.Text"
                            @bind:event="oninput"
                            @bind:after="() => HandleTextChangedAsync(block)"
                            disabled="@IsArchived"
                            placeholder="Write in Markdown… type / for commands"></textarea>

                        @if (PaletteState.IsOpen && _activeBlockId == block.Id)
                        {
                            <div class="slash-menu" style="top:@(_paletteTop.ToString(System.Globalization.CultureInfo.InvariantCulture))px; left:@(_paletteLeft.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
                                @if (PaletteState.Results.Count == 0)
                                {
                                    <div class="slash-menu-empty">No commands found.</div>
                                }
                                else
                                {
                                    var indexed = PaletteState.Results.Select((command, index) => (Command: command, Index: index));
                                    @foreach (var group in indexed.GroupBy(entry => entry.Command.Category))
                                    {
                                        <div class="slash-menu-group">
                                            <div class="slash-menu-group-title">
                                                <span>@CategoryIcon(group.Key)</span> @CategoryLabel(group.Key)
                                            </div>
                                            @foreach (var entry in group)
                                            {
                                                <div class="slash-menu-item @(entry.Index == PaletteState.SelectedIndex ? "selected" : "")"
                                                     @onclick="() => SelectCommandAsync(block, entry.Index)"
                                                     @onmouseenter="() => HoverCommand(entry.Index)">
                                                    <span class="slash-menu-icon">@entry.Command.Icon</span>
                                                    <span class="slash-menu-title">@entry.Command.Title</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private IReadOnlyList<CourseDto>? CourseList { get; set; }

    private NoteDto? EditingNote { get; set; }

    private string Title { get; set; } = string.Empty;

    private List<EditorBlock> Blocks { get; set; } = [new()];

    private Guid CourseId { get; set; }

    private bool IsArchived { get; set; }

    private bool IsSaving { get; set; }

    private bool IsLoaded { get; set; }

    private string? ErrorMessage { get; set; }

    private SlashCommandPaletteState PaletteState { get; set; } = null!;

    private DotNetObjectReference<NoteEditor>? _selfReference;

    private Guid? _activeBlockId;

    private int _triggerStart;

    private double _paletteTop;

    private double _paletteLeft;

    private Guid? _pendingFocusBlockId;

    private int _pendingFocusCaret;

    protected override async Task OnInitializedAsync()
    {
        PaletteState = new SlashCommandPaletteState(CommandRegistry);

        CourseList = await CourseManagement.GetAllAsync();

        if (Id is { } id)
        {
            EditingNote = await NoteManagement.GetByIdAsync(id);
            Title = EditingNote.Title;
            Blocks = ParseContent(EditingNote.Content);
            CourseId = EditingNote.CourseId;
            IsArchived = EditingNote.IsArchived;
            PageHeader.SetHeader(Title, "Editing note");
        }
        else
        {
            PageHeader.SetHeader("New Note", "Capture what you're learning");
        }

        IsLoaded = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Blazor owns the plain-text content of the code block on every render; re-run Prism
        // afterwards so it can re-wrap that text in highlighted spans. Blazor's own diffing
        // simply overwrites those spans back to plain text on the next render, so the two never
        // fight over the DOM.
        await JS.InvokeVoidAsync("studyHubNotes.highlightAll");

        if (_pendingFocusBlockId is { } blockId)
        {
            _pendingFocusBlockId = null;
            var block = Blocks.FirstOrDefault(b => b.Id == blockId);
            if (block is not null)
            {
                await JS.InvokeVoidAsync("studyHubNotes.focusAndSelect", block.TextAreaElement, _pendingFocusCaret, _pendingFocusCaret);
            }
        }
    }

    private async Task HandleTextChangedAsync(EditorBlock block)
    {
        var caretIndex = await JS.InvokeAsync<int>("studyHubNotes.getCaretIndex", block.TextAreaElement);
        var trigger = TriggerDetector.Detect(block.Text, caretIndex);

        if (trigger is null)
        {
            if (_activeBlockId == block.Id)
            {
                await ClosePaletteAsync(block);
            }

            return;
        }

        _triggerStart = trigger.Start;

        if (_activeBlockId != block.Id)
        {
            if (_activeBlockId is { } previousBlockId)
            {
                var previousBlock = Blocks.FirstOrDefault(b => b.Id == previousBlockId);
                if (previousBlock is not null)
                {
                    await JS.InvokeVoidAsync("studyHubNotes.setPaletteOpen", previousBlock.TextAreaElement, false);
                }
            }

            _activeBlockId = block.Id;
            PaletteState.Open(trigger.Query);

            var coordinates = await JS.InvokeAsync<CaretCoordinates>("studyHubNotes.getCaretCoordinates", block.TextAreaElement);
            _paletteTop = coordinates.Top + coordinates.Height + 6;
            _paletteLeft = coordinates.Left;

            await JS.InvokeVoidAsync("studyHubNotes.attachPaletteKeyHandler", block.TextAreaElement, _selfReference);
            await JS.InvokeVoidAsync("studyHubNotes.setPaletteOpen", block.TextAreaElement, true);
        }
        else
        {
            PaletteState.SetQuery(trigger.Query);
        }
    }

    [JSInvokable]
    public async Task OnPaletteKeyAsync(string key)
    {
        if (_activeBlockId is not { } blockId)
        {
            return;
        }

        var block = Blocks.FirstOrDefault(b => b.Id == blockId);
        if (block is null)
        {
            return;
        }

        switch (key)
        {
            case "ArrowDown":
                PaletteState.MoveSelection(1);
                break;
            case "ArrowUp":
                PaletteState.MoveSelection(-1);
                break;
            case "Escape":
                await ClosePaletteAsync(block);
                break;
            case "Enter":
            case "Tab":
                await ApplyCommandAsync(block);
                break;
        }

        StateHasChanged();
    }

    private void HoverCommand(int index) => PaletteState.SetSelectedIndex(index);

    private async Task SelectCommandAsync(EditorBlock block, int index)
    {
        PaletteState.SetSelectedIndex(index);
        await ApplyCommandAsync(block);
    }

    private async Task ApplyCommandAsync(EditorBlock block)
    {
        var command = PaletteState.GetSelected();
        if (command is null)
        {
            return;
        }

        var caretIndex = _triggerStart + 1 + PaletteState.Query.Length;
        var textBefore = block.Text[.._triggerStart];
        var textAfter = caretIndex <= block.Text.Length ? block.Text[caretIndex..] : string.Empty;

        var insertion = command.Apply(textBefore);

        await ClosePaletteAsync(block);

        if (command.Id == CodeBlockSlashCommand.CommandId)
        {
            ApplyCodeBlockInsertion(block, textBefore, textAfter);
            return;
        }

        block.Text = textBefore + insertion.Text + textAfter;
        _pendingFocusBlockId = block.Id;
        _pendingFocusCaret = textBefore.Length + insertion.CursorOffset;
    }

    private void ApplyCodeBlockInsertion(EditorBlock block, string textBefore, string textAfter)
    {
        var index = Blocks.IndexOf(block);
        var newBlocks = new List<EditorBlock>();

        if (textBefore.Length > 0)
        {
            newBlocks.Add(new EditorBlock { Text = textBefore });
        }

        var codeBlock = new EditorBlock { IsCode = true, Language = CodeBlockSlashCommand.DefaultLanguage };
        newBlocks.Add(codeBlock);

        if (textAfter.Length > 0)
        {
            newBlocks.Add(new EditorBlock { Text = textAfter });
        }

        Blocks.RemoveAt(index);
        Blocks.InsertRange(index, newBlocks);

        _pendingFocusBlockId = codeBlock.Id;
        _pendingFocusCaret = 0;
    }

    private async Task ClosePaletteAsync(EditorBlock block)
    {
        _activeBlockId = null;
        PaletteState.Close();
        await JS.InvokeVoidAsync("studyHubNotes.setPaletteOpen", block.TextAreaElement, false);
    }

    private static string CategoryLabel(SlashCommandCategory category) => category switch
    {
        SlashCommandCategory.Text => "Text",
        SlashCommandCategory.Lists => "Lists",
        SlashCommandCategory.Code => "Code",
        _ => category.ToString(),
    };

    private static string CategoryIcon(SlashCommandCategory category) => category switch
    {
        SlashCommandCategory.Text => "📝",
        SlashCommandCategory.Lists => "📋",
        SlashCommandCategory.Code => "💻",
        _ => string.Empty,
    };

    private static string NormalizeLanguage(string language) =>
        string.IsNullOrWhiteSpace(language) ? "none" : language.Trim().ToLowerInvariant();

    private static int GetRows(string text) => Math.Max(2, text.Count(c => c == '\n') + 2);

    private List<EditorBlock> ParseContent(string content)
    {
        var segments = BlockParser.Split(content);
        var blocks = segments
            .Select(segment => new EditorBlock
            {
                IsCode = segment.IsCode,
                Language = segment.Language,
                Text = segment.Text,
            })
            .ToList();

        return blocks.Count > 0 ? blocks : [new EditorBlock()];
    }

    private string SerializeBlocks() =>
        string.Join(
            "\n\n",
            Blocks
                .Where(b => b.IsCode || !string.IsNullOrWhiteSpace(b.Text))
                .Select(b => b.IsCode ? $"```{b.Language}\n{b.Text}\n```" : b.Text));

    private async Task SaveAsync()
    {
        IsSaving = true;
        ErrorMessage = null;

        try
        {
            var content = SerializeBlocks();
            var saved = EditingNote is null
                ? await NoteManagement.CreateAsync(new CreateNoteRequest(Title, content, CourseId))
                : await NoteManagement.UpdateAsync(new UpdateNoteRequest(EditingNote.Id, Title, content, CourseId));

            NavigationManager.NavigateTo($"/notes/{saved.Id}");
        }
        catch (NoteValidationException ex)
        {
            ErrorMessage = ex.Message;
        }
        catch (NoteArchivedException)
        {
            ErrorMessage = "This note is archived and cannot be edited.";
        }
        catch (CourseNotFoundException)
        {
            ErrorMessage = "The selected course could not be found.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    public void Dispose()
    {
        _selfReference?.Dispose();
    }

    private sealed class EditorBlock
    {
        public Guid Id { get; } = Guid.NewGuid();

        public bool IsCode { get; set; }

        public string Text { get; set; } = string.Empty;

        public string Language { get; set; } = string.Empty;

        public ElementReference TextAreaElement;
    }

    private sealed record CaretCoordinates(double Top, double Left, double Height);
}
