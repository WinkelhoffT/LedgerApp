@page "/Error"
@layout BlankLayout
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics
@inject IWebHostEnvironment Environment

<PageTitle>Etwas ist schiefgelaufen – StudyHub</PageTitle>

<ErrorPageLayout Title="Etwas ist schiefgelaufen"
                 Message="Bei der Verarbeitung ist ein unerwarteter Fehler aufgetreten. Bitte versuche es erneut oder kehre zum Dashboard zurück."
                 ButtonText="Zurück zum Dashboard"
                 ButtonHref="/"
                 ShowDetails="@Environment.IsDevelopment()">
    <IconContent>
        <text x="90" y="88" text-anchor="middle" font-size="18" font-weight="700" fill="#fff">!</text>
    </IconContent>
    <Details>
        <h2>Entwickler-Details (nur sichtbar in Development)</h2>
        @if (ShowRequestId)
        {
            <p>Request-ID: @RequestId</p>
        }
        @if (ExceptionText is not null)
        {
            <pre>@ExceptionText</pre>
        }
        else
        {
            <p>Keine Exception-Details verfügbar, z.B. weil diese Seite direkt aufgerufen wurde.</p>
        }
    </Details>
</ErrorPageLayout>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private string? ExceptionText { get; set; }

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        if (Environment.IsDevelopment())
        {
            var exceptionFeature = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
            if (exceptionFeature?.Error is { } exception)
            {
                ExceptionText = $"{exceptionFeature.Path}\n\n{exception}";
            }
        }
    }
}
