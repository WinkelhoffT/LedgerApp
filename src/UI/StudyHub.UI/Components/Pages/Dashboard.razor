@page "/"

<PageTitle>Dashboard</PageTitle>

<div class="card card-pad hero-card" style="margin-bottom:16px">
    @if (Progress is null)
    {
        <p class="placeholder-hint">Loading semester progress…</p>
    }
    else if (!Progress.HasActiveSemester)
    {
        <div class="hero-empty">
            <div class="empty-state-title">No active semester</div>
            <div class="empty-state-text">Create and activate a semester to see your progress here.</div>
            <a class="btn btn-primary" href="/semesters">Create Semester</a>
        </div>
    }
    else
    {
        <div class="hero-head">
            <div>
                <div class="hero-name">@Progress.SemesterName</div>
                <span class="hero-status">Active Semester</span>
            </div>
            <div class="hero-percent">@FormatPercent(Progress.PercentComplete)</div>
        </div>

        <div class="hero-progress-track">
            <div class="hero-progress-fill" style="width:@(FormatPercent(Progress.PercentComplete))"></div>
        </div>

        <div class="hero-info-grid">
            <div class="hero-info-tile">
                <div class="hero-info-label">Start</div>
                <div class="hero-info-val">@Progress.StartDate!.Value.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">End</div>
                <div class="hero-info-val">@Progress.EndDate!.Value.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">Elapsed</div>
                <div class="hero-info-val">@Progress.ElapsedDays days</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">Remaining</div>
                <div class="hero-info-val">@Progress.RemainingDays days</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">Length</div>
                <div class="hero-info-val">@Progress.TotalDays days</div>
            </div>
        </div>
    }
</div>

<div class="grid stat-grid" style="margin-bottom:16px">
    @foreach (var stat in Stats)
    {
        <div class="card stat placeholder-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@((MarkupString)stat.IconPaths)</svg>
            </div>
            <div>
                <div class="stat-val">@stat.Value</div>
                <div class="stat-label">@stat.Label</div>
            </div>
        </div>
    }
</div>

<div class="grid dash-grid">
    <div class="card card-pad placeholder-card">
        <div class="section-title">Today's Sessions</div>
        <p class="placeholder-hint">Platzhalter – Inhalt folgt</p>
        @for (var i = 1; i <= 3; i++)
        {
            <div class="placeholder-row">Session placeholder @i</div>
        }
    </div>

    <div class="card card-pad placeholder-card">
        <div class="section-title">Upcoming Deadlines</div>
        <p class="placeholder-hint">Platzhalter – Inhalt folgt</p>
        @for (var i = 1; i <= 3; i++)
        {
            <div class="placeholder-row">Deadline placeholder @i</div>
        }
    </div>
</div>
