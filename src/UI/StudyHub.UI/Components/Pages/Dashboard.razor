@page "/"
@inject IPageHeaderService PageHeader

<PageTitle>Dashboard</PageTitle>

<div class="grid stat-grid" style="margin-bottom:16px">
    @foreach (var stat in Stats)
    {
        <div class="card stat placeholder-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@((MarkupString)stat.IconPaths)</svg>
            </div>
            <div>
                <div class="stat-val">@stat.Value</div>
                <div class="stat-label">@stat.Label</div>
            </div>
        </div>
    }
</div>

<div class="grid dash-grid">
    <div class="card card-pad placeholder-card">
        <div class="section-title">Today's Sessions</div>
        <p class="placeholder-hint">Platzhalter – Inhalt folgt</p>
        @for (var i = 1; i <= 3; i++)
        {
            <div class="placeholder-row">Session placeholder @i</div>
        }
    </div>

    <div class="card card-pad placeholder-card">
        <div class="section-title">Upcoming Deadlines</div>
        <p class="placeholder-hint">Platzhalter – Inhalt folgt</p>
        @for (var i = 1; i <= 3; i++)
        {
            <div class="placeholder-row">Deadline placeholder @i</div>
        }
    </div>
</div>

@code {
    protected override void OnInitialized() => PageHeader.SetHeader("Dashboard", "Welcome back, Anna");

    private readonly record struct DashboardStat(string IconPaths, string Value, string Label);

    private static readonly DashboardStat[] Stats =
    [
        new(Icons.Clock, "24.5h", "Study time this week"),
        new(Icons.Flame, "18", "Day learning streak"),
        new(Icons.Check, "32", "Tasks completed"),
        new(Icons.Target, "59%", "Semester progress"),
    ];

    private static class Icons
    {
        public const string Clock = "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>";
        public const string Flame = "<path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/>";
        public const string Check = "<path d=\"M20 6L9 17l-5-5\"/>";
        public const string Target = "<circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/>";
    }
}
