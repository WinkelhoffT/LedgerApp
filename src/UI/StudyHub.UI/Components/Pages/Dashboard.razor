@page "/"
@using StudyHub.UI.Calendar

<PageTitle>Dashboard</PageTitle>

<div class="card card-pad hero-card" style="margin-bottom:16px">
    @if (Progress is null)
    {
        <p class="placeholder-hint">Loading semester progress…</p>
    }
    else if (!Progress.HasActiveSemester)
    {
        <div class="hero-empty">
            <div class="empty-state-title">No active semester</div>
            <div class="empty-state-text">Create and activate a semester to see your progress here.</div>
            <a class="btn btn-primary" href="/semesters">Create Semester</a>
        </div>
    }
    else
    {
        <div class="hero-head">
            <div>
                <div class="hero-name">@Progress.SemesterName</div>
                <span class="hero-status">Active Semester</span>
            </div>
            <div class="hero-percent">@FormatPercent(Progress.PercentComplete)</div>
        </div>

        <div class="hero-progress-track">
            <div class="hero-progress-fill" style="width:@(FormatPercent(Progress.PercentComplete))"></div>
        </div>

        <div class="hero-info-grid">
            <div class="hero-info-tile">
                <div class="hero-info-label">Start</div>
                <div class="hero-info-val">@Progress.StartDate!.Value.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">End</div>
                <div class="hero-info-val">@Progress.EndDate!.Value.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">Elapsed</div>
                <div class="hero-info-val">@Progress.ElapsedDays days</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">Remaining</div>
                <div class="hero-info-val">@Progress.RemainingDays days</div>
            </div>
            <div class="hero-info-tile">
                <div class="hero-info-label">Length</div>
                <div class="hero-info-val">@Progress.TotalDays days</div>
            </div>
        </div>
    }
</div>

<div class="card card-pad flashcards-due-card" style="margin-bottom:16px">
    <div class="flashcards-due-head">
        <div class="section-title">Flashcards due today</div>
        <a class="btn btn-outline btn-sm" href="flashcards">All decks</a>
    </div>
    @if (FlashcardsDue is null)
    {
        <p class="placeholder-hint">Loading flashcards…</p>
    }
    else if (FlashcardsDue.Total.Total == 0)
    {
        <div class="flashcards-due-empty">Nothing due today</div>
    }
    else
    {
        <div class="flashcards-due-totals">
            <div class="due-total"><span class="due-total-val count-new">@FlashcardsDue.Total.New</span><span class="due-total-label">New</span></div>
            <div class="due-total"><span class="due-total-val count-learning">@FlashcardsDue.Total.Learning</span><span class="due-total-label">Learning</span></div>
            <div class="due-total"><span class="due-total-val count-review">@FlashcardsDue.Total.Review</span><span class="due-total-label">To review</span></div>
        </div>
        <ul class="flashcards-due-list">
            @foreach (var deck in FlashcardsDue.Decks)
            {
                <li class="flashcards-due-row">
                    <a class="flashcards-due-name" href="@($"flashcards/decks/{deck.DeckId}")">@deck.Name</a>
                    <FlashcardStudyCounts Counts="deck.Counts" />
                    <a class="btn btn-primary btn-sm" href="@($"flashcards/study/{deck.DeckId}")">Study</a>
                </li>
            }
        </ul>
    }
</div>

<div class="grid stat-grid" style="margin-bottom:16px">
    @foreach (var stat in Stats)
    {
        <div class="card stat placeholder-card">
            <div class="stat-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@((MarkupString)stat.IconPaths)</svg>
            </div>
            <div>
                <div class="stat-val">@stat.Value</div>
                <div class="stat-label">@stat.Label</div>
            </div>
        </div>
    }
</div>

<div class="grid dash-grid">
    <div class="card card-pad">
        <div class="sessions-today-head">
            <div class="section-title">Today's Sessions</div>
            <a class="btn btn-outline btn-sm" href="calendar?view=week">View calendar</a>
        </div>
        @if (SessionsToday is null)
        {
            <p class="placeholder-hint">Loading sessions…</p>
        }
        else if (SessionsToday.Sessions.Count == 0)
        {
            <div class="sessions-today-empty">
                <span>No sessions today</span>
                <a href="calendar">Schedule a session</a>
            </div>
        }
        else
        {
            @foreach (var item in SessionsToday.Sessions)
            {
                <StudySessionCard Session="item.Session" />
            }
        }
    </div>

    <div class="card card-pad">
        <div class="section-title">Upcoming Exams &amp; Deadlines</div>
        @if (UpcomingEvents is null)
        {
            <p class="placeholder-hint">Loading exams and deadlines…</p>
        }
        else if (UpcomingEvents.Count == 0)
        {
            <div class="sessions-today-empty">
                <span>No exams or deadlines ahead</span>
                <a href="calendar">Add one in the calendar</a>
            </div>
        }
        else
        {
            <ul class="upcoming-list">
                @foreach (var item in UpcomingEvents)
                {
                    <li class="upcoming-row" style="--session-color:@CalendarFormatter.GetColor(item.Event)">
                        <span class="upcoming-icon" title="@CalendarFormatter.FormatKind(item.Event.Kind)">
                            <CalendarEventIcon Kind="item.Event.Kind" Size="15" />
                        </span>
                        <div class="upcoming-main">
                            <a class="upcoming-title" href="@CalendarFormatter.GetWeekUrl(item.Event.Date)"
                               aria-label="@CalendarFormatter.FormatEventLabel(item.Event)">@item.Event.Title</a>
                            <div class="upcoming-sub">@CalendarFormatter.FormatUpcomingDetails(item.Event)</div>
                        </div>
                        <span class="upcoming-countdown @(item.DaysUntil <= SoonDays ? "is-soon" : null)">@CalendarFormatter.FormatCountdown(item.DaysUntil)</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
