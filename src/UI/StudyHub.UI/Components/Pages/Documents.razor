@page "/documents"
@rendermode InteractiveServer
@using StudyHub.UI.Documents

<PageTitle>Documents</PageTitle>

<div class="page-toolbar">
    <select class="form-control scope-select" @bind="SelectedScope" @bind:after="LoadDocumentsAsync">
        <option value="all">All documents</option>
        @if (Courses.Count > 0)
        {
            <optgroup label="Courses">
                @foreach (var course in Courses)
                {
                    <option value="course:@course.Id">@course.Name</option>
                }
            </optgroup>
        }
        @if (Semesters.Count > 0)
        {
            <optgroup label="Semesters">
                @foreach (var semester in Semesters)
                {
                    <option value="semester:@semester.Id">@semester.Name</option>
                }
            </optgroup>
        }
    </select>

    <label class="toggle-check">
        <input type="checkbox" @bind="ShowArchived" />
        Show archived
    </label>

    <button class="btn btn-primary" type="button" @onclick="OpenUploadDialog">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        Upload Document
    </button>
</div>

@if (DocumentList is null)
{
    <p class="placeholder-hint">Loading documents…</p>
}
else if (VisibleDocuments.Count == 0)
{
    <div class="card empty-state">
        <div class="empty-state-title">@(DocumentList.Count == 0 ? "No documents yet" : "No archived documents")</div>
        <div class="empty-state-text">
            @(DocumentList.Count == 0
                ? "Upload your first document to attach it to a course or semester."
                : "Documents you archive will show up here.")
        </div>
        @if (DocumentList.Count == 0)
        {
            <button class="btn btn-primary" type="button" @onclick="OpenUploadDialog">Upload Document</button>
        }
    </div>
}
else
{
    <div class="grid document-grid">
        @foreach (var document in VisibleDocuments)
        {
            <div class="card document-card @(document.IsArchived ? "is-archived" : "")" @onclick="() => OpenDetailsDialog(document)">
                <div class="document-card-head">
                    <span class="document-name">@document.FileName</span>
                    @if (document.IsArchived)
                    {
                        <span class="badge-archived">Archived</span>
                    }
                </div>
                <div class="document-meta">@FileSizeFormatter.Format(document.SizeBytes) · @GetParentName(document)</div>
            </div>
        }
    </div>
}

<DocumentUploadDialog IsOpen="IsUploadDialogOpen" OnClose="CloseUploadDialog" OnSaved="HandleUploadedAsync" />
<DocumentDetailsDialog IsOpen="IsDetailsDialogOpen" Document="SelectedDocument" ParentName="@(SelectedDocument is null ? string.Empty : GetParentName(SelectedDocument))" OnClose="CloseDetailsDialog" OnChanged="HandleChangedAsync" />
