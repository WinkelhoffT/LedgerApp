@inherits LayoutComponentBase

<div class="app">
    <aside class="sidebar @(SidebarState.IsOpen ? "open" : "")" id="sidebar">
        <NavMenu />
    </aside>

    <div class="overlay @(SidebarState.IsOpen ? "show" : "")" @onclick="() => SidebarState.Close()"></div>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn hamburger" type="button" aria-label="Navigation umschalten" @onclick="() => SidebarState.Toggle()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18" /></svg>
            </button>
            <div>
                <div class="page-title">@PageHeader.Title</div>
                @if (!string.IsNullOrWhiteSpace(PageHeader.Subtitle))
                {
                    <div class="page-sub">@PageHeader.Subtitle</div>
                }
            </div>

            <button class="icon-btn theme-toggle" type="button"
                    aria-label="@(Theme.Theme == "dark" ? "Switch to light mode" : "Switch to dark mode")"
                    @onclick="() => Theme.ToggleAsync()">
                @if (Theme.Theme == "dark")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                }
            </button>
        </header>

        <main class="content">
            <div class="content-wide">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
