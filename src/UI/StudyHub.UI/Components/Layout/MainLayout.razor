@inherits LayoutComponentBase

<div class="app">
    <aside class="sidebar" id="sidebar">
        <NavMenu />
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn hamburger" type="button" aria-label="Navigation umschalten">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18" /></svg>
            </button>
            <div>
                <div class="page-title">@PageHeader.Title</div>
                @if (!string.IsNullOrWhiteSpace(PageHeader.Subtitle))
                {
                    <div class="page-sub">@PageHeader.Subtitle</div>
                }
            </div>
        </header>

        <main class="content">
            <div class="content-wide">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
