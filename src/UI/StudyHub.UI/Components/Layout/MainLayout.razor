@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <Topbar IsDarkMode="_isDarkMode" OnToggleDarkMode="ToggleDarkModeAsync" />

    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Class="app-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
